function escapeHTML(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function hashPassword(password) {
  return crypto
    .createHash("sha256")
    .update(String(password))
    .digest("hex");
}

function randomId() {
  return crypto.randomBytes(12).toString("hex");
}

function getUser(req) {
  if (!req.session.userId) return null;

  return db.users.find(
    x => x.id === req.session.userId
  ) || null;
}

function requireLogin(req, res, next) {
  const user = getUser(req);

  if (!user) {
    return res.redirect("/login");
  }

  req.user = user;
  next();
}

function requireCreator(req, res, next) {
  if (!req.session.creator) {
    return res.redirect("/creator/login");
  }

  next();
}

function getBotForOwner(req, id) {
  return db.bots.find(
    bot =>
      bot.id === id &&
      bot.ownerId === req.user.id
  );
}

function getCommands(botId) {
  if (!Array.isArray(db.commands[botId])) {
    db.commands[botId] = [];
  }

  return db.commands[botId];
}

function getBotUsers(botId) {
  if (!Array.isArray(db.botUsers[botId])) {
    db.botUsers[botId] = [];
  }

  return db.botUsers[botId];
}

function normalizeCommand(command) {
  return String(command || "")
    .trim()
    .replace(/^\/+/, "")
    .split(/\s+/)[0]
    .toLowerCase();
}

function parsePublicTelegramLink(input) {
  let value = String(input || "").trim();

  if (!value) return null;

  if (!/^https?:\/\/t\.me\//i.test(value)) {
    if (/^t\.me\//i.test(value)) {
      value = "https://" + value;
    } else {
      return null;
    }
  }

  try {
    const url = new URL(value);

    if (url.hostname.toLowerCase() !== "t.me") {
      return null;
    }

    const parts = url.pathname
      .split("/")
      .filter(Boolean);

    if (parts.length !== 1) {
      return null;
    }

    const username = parts[0];

    if (
      username.startsWith("+") ||
      username.toLowerCase() === "joinchat"
    ) {
      return null;
    }

    if (!/^[A-Za-z0-9_]{5,32}$/.test(username)) {
      return null;
    }

    return {
      username: "@" + username,
      link: "https://t.me/" + username
    };
  } catch {
    return null;
  }
}

async function telegram(token, method, data = {}) {
  const response = await fetch(
    `https://api.telegram.org/bot${token}/${method}`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(data)
    }
  );

  const result = await response.json();

  if (!result.ok) {
    throw new Error(
      result.description || "Telegram API error"
    );
  }

  return result.result;
}

async function sendTelegramMessage(token, chatId, text, extra = {}) {
  return telegram(token, "sendMessage", {
    chat_id: chatId,
    text,
    ...extra
  });
}

async function deleteTelegramMessage(token, chatId, messageId) {
  try {
    return await telegram(token, "deleteMessage", {
      chat_id: chatId,
      message_id: messageId
    });
  } catch {
    return null;
  }
}

// ----------------------------------------------------
// Telegram / Force Join
// ----------------------------------------------------

async function checkMembership(bot, chatUsername, userId) {
  try {
    const member = await telegram(
      bot.token,
      "getChatMember",
      {
        chat_id: chatUsername,
        user_id: userId
      }
    );

    const status = member.status;

    if (
      status === "creator" ||
      status === "administrator" ||
      status === "member"
    ) {
      return true;
    }

    if (
      status === "restricted" &&
      member.is_member === true
    ) {
      return true;
    }

    return false;
  } catch {
    return false;
  }
}

async function checkAllMemberships(bot, userId) {
  const joins = Array.isArray(bot.forceJoins)
    ? bot.forceJoins
    : [];

  for (const join of joins) {
    const ok = await checkMembership(
      bot,
      join.username,
      userId
    );

    if (!ok) {
      return {
        ok: false,
        missing: join
      };
    }
  }

  return {
    ok: true,
    missing: null
  };
}

async function sendJoinMessage(bot, chatId) {
  const joins = Array.isArray(bot.forceJoins)
    ? bot.forceJoins
    : [];

  const buttons = [];

  for (const join of joins) {
    buttons.push([
      {
        text:
          join.type === "channel"
            ? `📢 عضویت در ${join.title || join.username}`
            : `👥 عضویت در ${join.title || join.username}`,
        url: join.link
      }
    ]);
  }

  buttons.push([
    {
      text: "✅ بررسی عضویت",
      callback_data: "check_join"
    }
  ]);

  return sendTelegramMessage(
    bot.token,
    chatId,
    "🔒 برای استفاده از این ربات ابتدا در موارد زیر عضو شوید:\n\n" +
      joins
        .map(
          (x, i) =>
            `${i + 1}. ${x.title || x.username}`
        )
        .join("\n") +
      "\n\nبعد از عضویت روی «✅ بررسی عضویت» بزنید.",
    {
      reply_markup: {
        inline_keyboard: buttons
      }
    }
  );
}

async function checkBotAdminInChat(bot, chatUsername) {
  const me = await telegram(
    bot.token,
    "getMe"
  );

  const member = await telegram(
    bot.token,
    "getChatMember",
    {
      chat_id: chatUsername,
      user_id: me.id
    }
  );

  if (
    member.status !== "administrator" &&
    member.status !== "creator"
  ) {
    throw new Error(
      "ربات در این کانال یا گروه ادمین نیست."
    );
  }

  return {
    me,
    member
  };
}

// ----------------------------------------------------
// Bot Commands
// ----------------------------------------------------

async function executeCommand(bot, chatId, text) {
  const commands = getCommands(bot.id);

  if (!Array.isArray(commands) || commands.length === 0) {
    return false;
  }

  const first = String(text || "")
    .trim()
    .split(/\s+/)[0]
    .toLowerCase();

  if (!first.startsWith("/")) {
    return false;
  }

  const commandName = first
    .split("@")[0]
    .replace(/^\/+/, "")
    .toLowerCase();

  const command = commands.find(
    x =>
      String(x.name).toLowerCase() === commandName
  );

  if (!command) {
    return false;
  }

  await sendTelegramMessage(
    bot.token,
    chatId,
    command.reply
  );

  return true;
}

// ----------------------------------------------------
// Save Telegram User
// ----------------------------------------------------

function saveTelegramUser(bot, message) {
  if (!message.from) return;

  const botUsers = getBotUsers(bot.id);

  const telegramId = String(message.from.id);

  const exists = botUsers.find(
    x => String(x.id) === telegramId
  );

  if (exists) {
    exists.first_name =
      message.from.first_name || exists.first_name || "";

    exists.last_name =
      message.from.last_name || exists.last_name || "";

    exists.username =
      message.from.username || exists.username || "";

    exists.lastSeen = new Date().toISOString();
  } else {
    botUsers.push({
      id: telegramId,
      first_name: message.from.first_name || "",
      last_name: message.from.last_name || "",
      username: message.from.username || "",
      firstSeen: new Date().toISOString(),
      lastSeen: new Date().toISOString()
    });
  }

  saveDB();
}

// ----------------------------------------------------
// Callback
// ----------------------------------------------------

async function handleCallback(bot, callback) {
  if (!callback.message) return;

  const chatId = callback.message.chat.id;

  if (callback.data === "check_join") {
    const result = await checkAllMemberships(
      bot,
      callback.from.id
    );

    if (!result.ok) {
      try {
        await telegram(
          bot.token,
          "answerCallbackQuery",
          {
            callback_query_id: callback.id,
            text: "❌ ابتدا در همه موارد عضو شوید.",
            show_alert: true
          }
        );
      } catch {}

      return;
    }

    try {
      await telegram(
        bot.token,
        "answerCallbackQuery",
        {
          callback_query_id: callback.id,
          text: "✅ عضویت شما تأیید شد."
        }
      );
    } catch {}

    await deleteTelegramMessage(
      bot.token,
      chatId,
      callback.message.message_id
    );

    return;
  }
}

// ----------------------------------------------------
// Handle Telegram Updates
// ----------------------------------------------------

async function handleUpdate(bot, update) {
  if (update.callback_query) {
    await handleCallback(
      bot,
      update.callback_query
    );
    return;
  }

  if (!update.message) return;

  const message = update.message;
  const chatId = message.chat.id;

  saveTelegramUser(bot, message);

  // عضویت اجباری فقط وقتی فعال است
  if (
    Array.isArray(bot.forceJoins) &&
    bot.forceJoins.length > 0 &&
    message.from
  ) {
    const joined = await checkAllMemberships(
      bot,
      message.from.id
    );

    if (!joined.ok) {
      await sendJoinMessage(
        bot,
        chatId
      );
      return;
    }
  }

  if (!message.text) {
    return;
  }

  // فقط دستورهای ذخیره شده پاسخ می‌دهند
  const handled = await executeCommand(
    bot,
    chatId,
    message.text
  );

  if (handled) {
    return;
  }

  // هیچ پاسخ خودکاری ارسال نمی‌شود
  return;
}

// ----------------------------------------------------
// Polling
// ----------------------------------------------------

async function pollBot(bot) {
  if (bot.polling) return;

  bot.polling = true;

  while (true) {
    try {
      const updates = await telegram(
        bot.token,
        "getUpdates",
        {
          offset: Number(bot.offset || 0),
          timeout: 25,
          allowed_updates: [
            "message",
            "callback_query"
          ]
        }
      );

      for (const update of updates) {
        bot.offset = update.update_id + 1;
        saveDB();

        try {
          await handleUpdate(
            bot,
            update
          );
        } catch (err) {
          console.error(
            `خطای پردازش ربات ${bot.username}:`,
            err.message
          );
        }
      }
    } catch (err) {
      console.error(
        `خطای polling ربات ${bot.username}:`,
        err.message
      );

      await new Promise(
        resolve => setTimeout(resolve, 5000)
      );
    }
  }
}

async function startAllBots() {
  for (const bot of db.bots) {
    pollBot(bot).catch(err => {
      console.error(
        "Polling error:",
        err.message
      );
    });
  }
}

