        username: parsed.username,
        link: parsed.link,
        title:
          chat.title ||
          parsed.username,
        type: chat.type,
        updatedAt:
          new Date().toISOString()
      };

      bot.forceJoins.push(join);

      saveDB();

      res.redirect(
        `/bot/${bot.id}/force-join`
      );
