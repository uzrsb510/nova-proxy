app.post("/add-bot", requireLogin, async (req, res) => {
  const token = String(
    req.body.token || ""
  ).trim();

  if (!token) {
    return res.send(
      page(
        "خطا",
        `
<div class="card">
<div class="notice error">
❌ توکن را وارد کنید.
</div>
<a class="btn" href="/add-bot">بازگشت</a>
</div>
`,
        req
      )
    );
  }

  try {
    const info = await telegram(
      token,
      "getMe"
    );

    const already = db.bots.find(
      x => x.token === token
    );

    if (already) {
      return res.send(
        page(
          "خطا",
          `
<div class="card">
<div class="notice error">
❌ این ربات قبلاً در سیستم اضافه شده است.
</div>
<a class="btn" href="/my-bots">بازگشت</a>
</div>
`,
          req
        )
      );
    }

    const bot = {
      id: randomId(),
      ownerId: req.user.id,
      token,
      name:
        info.first_name ||
        info.username ||
        "ربات جدید",
      username:
        info.username || "",
      telegramId: info.id,
      offset: 0,
      createdAt: new Date().toISOString(),
      forceJoins: []
    };

    db.bots.push(bot);
    db.botUsers[bot.id] = [];
    db.commands[bot.id] = [];

    saveDB();

    pollBot(bot).catch(err => {
      console.error(
        "Polling bot error:",
        err.message
      );
    });

    res.redirect(
      `/bot/${bot.id}`
    );
  } catch (err) {
    res.send(
      page(
        "خطا",
        `
<div class="card">

<div class="notice error">
❌ توکن ربات معتبر نیست یا تلگرام آن را قبول نکرد.
<br><br>
${escapeHTML(err.message)}
</div>

<a class="btn" href="/add-bot">
بازگشت
</a>

</div>
`,
        req
      )
    );
  }
});

