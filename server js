app.post(
  "/creator/broadcast",
  requireCreator,
  async (req, res) => {
    const text = String(
      req.body.text || ""
    ).trim();

    if (!text) {
      return res.redirect(
        "/creator"
      );
    }

    let success = 0;
    let failed = 0;

    for (const bot of db.bots) {
      const users = getBotUsers(
        bot.id
      );

      for (const user of users) {
        try {
          await sendTelegramMessage(
            bot.token,
            user.id,
            text
          );

          success++;
        } catch {
          failed++;
        }
      }
    }

    res.send(
      page(
        "نتیجه ارسال",
        `
<div class="auth">

<div class="card">

<div class="notice success">

✅ ارسال انجام شد.

<br><br>

ارسال موفق:
<b>${success}</b>

<br>

ناموفق:
<b>${failed}</b>

</div>

<a
 href="/creator"
 class="btn"
>
⬅️ بازگشت به پنل سازنده
</a>

</div>

</div>
`,
        req,
        { showMenu: false }
      )
    );
  }
);

app.post(
  "/creator/logout",
  requireCreator,
  (req, res) => {
    req.session.creator = false;
    res.redirect("/creator/login");
  }
);

