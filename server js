const DATA_DIR = path.join(__dirname, "data");
const DATA_FILE = path.join(DATA_DIR, "data.json");

if (!fs.existsSync(DATA_DIR)) {
  fs.mkdirSync(DATA_DIR, { recursive: true });
}

function defaultDB() {
  return {
    users: [],
    bots: [],
    botUsers: {},
    commands: {}
  };
}

function loadDB() {
  try {
    if (!fs.existsSync(DATA_FILE)) {
      const db = defaultDB();
      fs.writeFileSync(DATA_FILE, JSON.stringify(db, null, 2));
      return db;
    }

    const db = JSON.parse(fs.readFileSync(DATA_FILE, "utf8"));

    db.users = Array.isArray(db.users) ? db.users : [];
    db.bots = Array.isArray(db.bots) ? db.bots : [];
    db.botUsers = db.botUsers && typeof db.botUsers === "object"
      ? db.botUsers
      : {};
    db.commands = db.commands && typeof db.commands === "object"
      ? db.commands
      : {};

    // مهاجرت نسخه‌های قدیمی forceJoin به forceJoins
    for (const bot of db.bots) {
      if (!Array.isArray(bot.forceJoins)) {
        bot.forceJoins = bot.forceJoin ? [bot.forceJoin] : [];
      }

      if (!Array.isArray(db.botUsers[bot.id])) {
        db.botUsers[bot.id] = [];
      }

      if (!Array.isArray(db.commands[bot.id])) {
        db.commands[bot.id] = [];
      }
    }

    return db;
  } catch (err) {
    console.error("خطا در خواندن data.json:", err);

    const db = defaultDB();
    fs.writeFileSync(DATA_FILE, JSON.stringify(db, null, 2));
    return db;
  }
}

let db = loadDB();

function saveDB() {
  fs.writeFileSync(
    DATA_FILE,
    JSON.stringify(db, null, 2),
    "utf8"
  );
}

