  requireLogin,
  (req, res) => {

    res.send(
      layout(
        "افزودن ربات",

        `
        <div class="card">

          <h1>
            ➕ افزودن ربات
          </h1>

          <p class="muted">
            توکن ربات را از BotFather وارد کنید.
          </p>

          <form
            method="POST"
            action="/bots/add"
          >

            <label>
              توکن ربات
            </label>

            <input
              name="token"
              placeholder="123456789:ABC..."
              required
            >

            <button
              class="btn green"
            >
              ➕ افزودن ربات
            </button>

          </form>

        </div>
        `,

