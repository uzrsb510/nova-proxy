function messagePage(
  title,
  message,
  req,
  type = ""
) {
  return layout(
    title,

    `
    <div class="card">

      <div class="alert ${type}">
        ${escapeHtml(
          message
        )}
      </div>

      <a
        class="btn"
        href="/"
      >
        🏠 بازگشت
      </a>

    </div>
    `,

    req
  );
}


