app.post(
  "/commands/add",
  requireLogin,
  (req, res) => {

    const user =
      getUser(req);

    const bot =
      db.bots.find(
        x =>
          x.id ===
            req.body.botId &&
          x.ownerId ===
            user.id
      );

    if (!bot) {

      return res
        .status(404)
        .send(
          messagePage(
            "خطا",
            "ربات پیدا نشد.",
            req,
            "error"
          )
        );
    }

    let name =
      String(
        req.body.name ||
        ""
      )
        .trim()
        .replace(
          /^\/+/,
          ""
        )
        .toLowerCase();

    const reply =
      String(
        req.body.reply ||
        ""
      ).trim();

    if (
      !name ||
      !/^[a-zA-Z0-9_]{1,32}$/.test(
        name
      )
    ) {

      return res.send(
        messagePage(
          "خطا",
          "نام دستور معتبر نیست.",
          req,
          "error"
        )
      );
    }

    if (!reply) {

      return res.send(
        messagePage(
          "خطا",
          "متن پاسخ خالی است.",
          req,
          "error"
        )
      );
    }

    const commands =
      getCommands(
        bot.id
      );

    const exists =
      commands.some(
        x =>
          String(
            x.name
          ).toLowerCase() ===
          name
      );

    if (exists) {

      return res.send(
        messagePage(
          "خطا",
          "این دستور قبلاً وجود دارد.",
          req,
          "error"
        )
      );
    }

    commands.push({
      id:
        makeId(),

      name:
        name,

      reply:
        reply,

      createdAt:
        new Date().toISOString()
    });

    saveDB();

    res.redirect(
      `/commands?bot=${bot.id}`
    );
  }
);

app.post(
