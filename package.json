app.post(
  "/bots/add",
  requireLogin,
  async (req, res) => {

    const user =
      getUser(req);

    const token =
      String(
        req.body.token ||
        ""
      ).trim();

    if (!token) {

      return res.send(
        messagePage(
          "خطا",
          "توکن وارد نشده است.",
          req,
          "error"
        )
      );
    }

    try {

      const me =
        await telegram(
          token,
          "getMe"
        );

      const already =
        db.bots.some(
          bot =>
            bot.token ===
            token
        );

      if (already) {

        return res.send(
          messagePage(
            "خطا",
            "این ربات قبلاً اضافه شده است.",
            req,
            "error"
          )
        );
      }

      const bot = {

        id:
          makeId(),

        ownerId:
          user.id,

        token:
          token,

        name:
          me.first_name ||
          me.username ||
          "ربات",

        username:
          me.username ||
          "",

        telegramId:
          me.id,

        offset: 0,

        createdAt:
          new Date().toISOString(),

        forceJoins: []
      };

      db.bots.push(
        bot
      );

      db.botUsers[
        bot.id
      ] = [];

      db.commands[
        bot.id
      ] = [];

      db.verifiedMembers[
        bot.id
      ] = [];

      saveDB();

      startBotPolling(
        bot
      );

      res.redirect(
        `/bots/${bot.id}`
      );

    } catch (err) {

      res.send(
        messagePage(
          "خطا",

          "توکن ربات معتبر نیست یا ارتباط با تلگرام برقرار نشد: " +
            err.message,

          req,

          "error"
        )
      );
    }
  }
);


