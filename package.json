      )
    );
  }
);


/*
==================================================
Broadcast سازنده
==================================================
*/

app.get(
  "/creator/broadcast",
  requireCreator,
  (req, res) => {

    res.send(
      layout(
        "ارسال پیام همگانی",

        `
        <div class="card">

          <h1>
            📢 ارسال پیام به همه کاربران
          </h1>

          <p class="muted">
            پیام برای کاربران تمام ربات‌های ثبت‌شده ارسال می‌شود.
          </p>

          <form
            method="POST"
            action="/creator/broadcast"
          >

            <textarea
              name="message"
              required
              placeholder="متن پیام..."
            ></textarea>

            <button
              class="btn"
            >
              📢 ارسال به همه
            </button>

          </form>

        </div>
        `,

        req
      )
    );
  }
);

app.post(
  "/creator/broadcast",
  requireCreator,
  async (req, res) => {

    const text =
      String(
        req.body.message ||
        ""
      ).trim();

    if (!text) {

      return res.send(
        messagePage(
          "خطا",
          "پیام خالی است.",
          req,
          "error"
        )
      );
    }

    let sent = 0;

    const processed =
      new Set();

    for (
      const bot of db.bots
    ) {

      const users =
        Array.isArray(
          db.botUsers[
            bot.id
          ]
        )
          ? db.botUsers[
              bot.id
            ]
          : [];

      for (
        const telegramUser of users
      ) {

        const key =
          `${bot.id}:${telegramUser.chatId}`;

        if (
          processed.has(
            key
          )
        ) {
          continue;
        }

        processed.add(
          key
        );

        try {

          await sendTelegramMessage(
            bot.token,
            telegramUser.chatId,
            text
          );

          sent++;

        } catch {}
      }
    }

    res.send(
      messagePage(
        "ارسال شد",

        `پیام برای ${sent} کاربر ارسال شد.`,

        req,

        "success"
      )
    );
  }
);


