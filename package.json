/*
==================================================
حذف ربات
==================================================
*/

app.post(
  "/bots/:id/delete",
  requireLogin,
  (req, res) => {

    const bot =
      getBotForUser(
        req,
        req.params.id
      );

    if (!bot) {

      return res
        .status(404)
        .send(
          messagePage(
            "خطا",
            "ربات پیدا نشد.",
            req,
            "error"
          )
        );
    }

    stopBotPolling(
      bot.id
    );

    db.bots =
      db.bots.filter(
        x =>
          x.id !==
          bot.id
      );

    delete db.botUsers[
      bot.id
    ];

    delete db.commands[
      bot.id
    ];

    delete db.verifiedMembers[
      bot.id
    ];

    saveDB();

    res.redirect(
      "/bots"
    );
  }
);


/*
==================================================
دستورات
==================================================
*/

app.get(
  "/commands",
  requireLogin,
  (req, res) => {

    const user =
      getUser(req);

    const botId =
      String(
        req.query.bot ||
        ""
      );

    const bots =
      getUserBots(
        user.id
      );

    let selectedBot =
      bots.find(
        x =>
          x.id ===
          botId
      );

    if (!selectedBot) {
      selectedBot =
        bots[0];
    }

    if (!selectedBot) {

      return res.send(
