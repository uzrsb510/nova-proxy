);

function hashPassword(password) {
  return crypto
    .createHash("sha256")
    .update(String(password))
    .digest("hex");
}

function makeId(length = 12) {
  return crypto
    .randomBytes(16)
    .toString("hex")
    .slice(
      0,
      length
    );
}

function escapeHtml(value) {
  return String(value ?? "")
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );
}

function getUser(req) {
  if (!req.session.userId) {
    return null;
  }

  return (
    db.users.find(
      x =>
        x.id ===
        req.session.userId
    ) || null
  );
}

function requireLogin(
  req,
  res,
  next
) {
  if (!getUser(req)) {
    return res.redirect(
      "/login"
    );
  }

  next();
}

function requireCreator(
  req,
  res,
  next
) {
  if (!req.session.creator) {
    return res.redirect(
      "/creator/login"
    );
  }

  next();
}

function getUserBots(userId) {
  return db.bots.filter(
    bot =>
      bot.ownerId ===
      userId
  );
}

function getBotForUser(
  req,
  botId
) {
  const user =
    getUser(req);

  if (!user) {
    return null;
  }

  return (
    db.bots.find(
      bot =>
        bot.id === botId &&
        bot.ownerId ===
        user.id
    ) || null
  );
}

function getCommands(botId) {
  if (
    !Array.isArray(
      db.commands[botId]
    )
  ) {
    db.commands[botId] = [];
  }

  return db.commands[botId];
}


/*
==================================================
تلگرام
==================================================
*/

function telegramUrl(
  token,
  method
) {
  return `https://api.telegram.org/bot${token}/${method}`;
}

async function telegram(
  token,
  method,
  body = {}
) {
  const response =
    await fetch(
      telegramUrl(
        token,
        method
      ),
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json"
        },

        body:
          JSON.stringify(body)
      }
    );

  const data =
    await response.json();

  if (!data.ok) {
    throw new Error(
      data.description ||
      "Telegram API Error"
    );
  }

  return data.result;
}

async function sendTelegramMessage(
  token,
  chatId,
  text
) {
  return telegram(
    token,
    "sendMessage",
    {
      chat_id: chatId,
      text: String(
        text || ""
      )
    }
  );
}


/*
==================================================
عضویت اجباری
==================================================
*/

function getVerifiedMembers(
  botId
) {
  if (
    !Array.isArray(
      db.verifiedMembers[botId]
    )
  ) {
    db.verifiedMembers[botId] = [];
  }

  return db.verifiedMembers[botId];
}


/*
این امضا مشخص می‌کند کاربر برای کدام
کانال‌ها / گروه‌ها تأیید شده است.

اگر تنظیمات عضویت اجباری تغییر کند،
امضای جدید ساخته می‌شود و کاربر باید
دوباره بررسی شود.
*/
function getForceJoinSignature(
  bot
) {
  const joins =
    Array.isArray(
      bot.forceJoins
    )
      ? bot.forceJoins
      : [];

  return JSON.stringify(
    joins.map(
      join => ({
        username:
          String(
            join.username || ""
          )
            .trim()
            .toLowerCase(),

        link:
          String(
            join.link || ""
          )
            .trim()
            .toLowerCase()
      })
    )
  );
}

function isUserVerified(
  bot,
  userId
) {
  const list =
    getVerifiedMembers(
      bot.id
    );

  const signature =
    getForceJoinSignature(
      bot
    );

  const item =
    list.find(
      x =>
        String(
          x.userId
        ) ===
        String(userId)
    );

  if (!item) {
    return false;
  }

  return (
    item.signature ===
    signature
  );
}

function markUserVerified(
  bot,
  userId
) {
  const list =
    getVerifiedMembers(
      bot.id
    );

  const signature =
    getForceJoinSignature(
      bot
    );

  const existing =
    list.find(
      x =>
        String(
          x.userId
        ) ===
        String(userId)
    );

  if (existing) {

    existing.signature =
      signature;

    existing.updatedAt =
      new Date().toISOString();

  } else {

    list.push({
      userId:
        userId,

      signature:
        signature,

      verifiedAt:
        new Date().toISOString()
    });
  }

  saveDB();
}


/*
بررسی واقعی عضویت کاربر
*/
async function checkMembership(
  bot,
  chatUsername,
  userId
) {
  try {

    const member =
      await telegram(
        bot.token,
        "getChatMember",
        {
          chat_id:
            chatUsername,

          user_id:
            userId
        }
      );

    const status =
      member.status;

    if (
      status ===
        "creator" ||
      status ===
        "administrator" ||
      status ===
        "member"
    ) {
      return true;
    }

    if (
      status ===
        "restricted" &&
      member.is_member ===
        true
    ) {
      return true;
    }

    return false;

  } catch (err) {

    console.error(
      "Membership check error:",
      err.message
    );

    return false;
  }
}


/*
بررسی تمام کانال‌ها و گروه‌ها
*/
async function checkAllMemberships(
  bot,
  userId
) {
  const joins =
    Array.isArray(
      bot.forceJoins
    )
      ? bot.forceJoins
      : [];

  /*
  اگر هیچ عضویت اجباری تنظیم نشده
  */
  if (joins.length === 0) {
    return {
      ok: true,
      missing: null
    };
  }

  /*
  اگر کاربر قبلاً برای همین
  تنظیمات تأیید شده باشد،
  دوباره از تلگرام سؤال نمی‌کنیم.
  */
  if (
    isUserVerified(
      bot,
      userId
    )
  ) {
    return {
      ok: true,
      missing: null,
      alreadyVerified: true
    };
  }

  /*
  بررسی واقعی تک تک کانال‌ها
  */
  for (
    const join of joins
  ) {

    const ok =
      await checkMembership(
        bot,
        join.username,
        userId
      );

    if (!ok) {

      return {
        ok: false,
        missing: join
      };
    }
  }

  /*
  همه موارد تأیید شدند
  */
  markUserVerified(
    bot,
    userId
  );

  return {
    ok: true,
    missing: null,
    alreadyVerified: false
  };
}


/*
پیام عضویت اجباری
*/
async function sendJoinMessage(
  bot,
  chatId
) {
  const joins =
    Array.isArray(
      bot.forceJoins
    )
      ? bot.forceJoins
      : [];

  const keyboard = [];

  for (
    const join of joins
  ) {

    keyboard.push([
      {
        text:
          `📢 ${
            join.title ||
            join.username
          }`,

        url:
          join.link
      }
    ]);
  }

  keyboard.push([
    {
      text:
        "✅ بررسی عضویت",

      callback_data:
        "check_join"
    }
  ]);

  await telegram(
    bot.token,
    "sendMessage",
    {
      chat_id:
        chatId,

      text:
        "🔒 برای استفاده از ربات ابتدا باید در موارد زیر عضو شوید:\n\n" +
        "بعد از عضویت روی «✅ بررسی عضویت» بزنید.",

      reply_markup: {
        inline_keyboard:
          keyboard
      }
    }
  );
}


