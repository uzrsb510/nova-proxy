app.post(
  "/broadcast",
  requireLogin,
  async (req, res) => {

    const user =
      getUser(req);

    const bot =
      db.bots.find(
        x =>
          x.id ===
            req.body.botId &&
          x.ownerId ===
            user.id
      );

    if (!bot) {

      return res
        .status(404)
        .send(
          messagePage(
            "خطا",
            "ربات پیدا نشد.",
            req,
            "error"
          )
        );
    }

    const text =
      String(
        req.body.message ||
        ""
      ).trim();

    if (!text) {

      return res.send(
        messagePage(
          "خطا",
          "پیام خالی است.",
          req,
          "error"
        )
      );
    }

    const users =
      Array.isArray(
        db.botUsers[
          bot.id
        ]
      )
        ? db.botUsers[
            bot.id
          ]
        : [];

    let sent = 0;

    for (
      const telegramUser of users
    ) {

      try {

        await sendTelegramMessage(
          bot.token,
          telegramUser.chatId,
          text
        );

        sent++;

      } catch {}
    }

    res.send(
      messagePage(
        "ارسال شد",

        `پیام برای ${sent} کاربر ارسال شد.`,

        req,

        "success"
      )
    );
  }
);


