app.post(
  "/forcejoin/add",
  requireLogin,
  async (req, res) => {

    const user =
      getUser(req);

    const bot =
      db.bots.find(
        x =>
          x.id ===
            req.body.botId &&
          x.ownerId ===
            user.id
      );

    if (!bot) {

      return res
        .status(404)
        .send(
          messagePage(
            "خطا",
            "ربات پیدا نشد.",
            req,
            "error"
          )
        );
    }

    if (
      !Array.isArray(
        bot.forceJoins
      )
    ) {
      bot.forceJoins = [];
    }

    if (
      bot.forceJoins.length >= 5
    ) {

      return res.send(
        messagePage(
          "خطا",
          "حداکثر ۵ کانال یا گروه قابل ثبت است.",
          req,
          "error"
        )
      );
    }

    const parsed =
      parsePublicTelegramLink(
        req.body.link
      );

    if (!parsed) {

      return res.send(
        messagePage(
          "خطا",
          "لینک عمومی تلگرام معتبر نیست.",
          req,
          "error"
        )
      );
    }

    const duplicate =
      bot.forceJoins.some(
        x =>
          x.username
            .toLowerCase() ===
          parsed.username
            .toLowerCase()
      );

    if (duplicate) {

      return res.send(
        messagePage(
          "خطا",
          "این کانال یا گروه قبلاً اضافه شده است.",
          req,
          "error"
        )
      );
    }

    try {

      const chat =
        await telegram(
          bot.token,
          "getChat",
          {
            chat_id:
              parsed.username
          }
        );

      if (
        ![
          "channel",
          "supergroup",
          "group"
        ].includes(
          chat.type
        )
      ) {

        throw new Error(
          "این لینک مربوط به کانال یا گروه نیست."
        );
      }

      await checkBotAdminInChat(
        bot,
        parsed.username
      );

      bot.forceJoins.push({
        username:
          parsed.username,

        link:
          parsed.link,

        title:
          chat.title ||
          parsed.username,

        type:
          chat.type
      });

      /*
      تغییر تنظیمات باعث می‌شود
      کاربران برای تنظیمات جدید
      دوباره بررسی شوند.
      */
      saveDB();

      res.redirect(
        `/forcejoin?bot=${bot.id}`
      );

    } catch (err) {

      res.send(
        messagePage(
          "خطا",
          err.message,
          req,
          "error"
        )
      );
    }
  }
);


/*
==================================================
حذف عضویت اجباری
==================================================
*/

app.post(
  "/forcejoin/delete",
  requireLogin,
  (req, res) => {

    const user =
      getUser(req);

    const bot =
      db.bots.find(
        x =>
          x.id ===
            req.body.botId &&
          x.ownerId ===
            user.id
      );

    if (!bot) {

      return res
        .status(404)
        .send(
          messagePage(
            "خطا",
            "ربات پیدا نشد.",
            req,
            "error"
          )
        );
    }

    const index =
      Number(
        req.body.index
      );

    if (
      !Array.isArray(
        bot.forceJoins
      ) ||
      !Number.isInteger(
        index
      ) ||
      index < 0 ||
      index >=
        bot.forceJoins.length
    ) {

      return res.send(
        messagePage(
          "خطا",
          "مورد موردنظر پیدا نشد.",
          req,
          "error"
        )
      );
    }

    /*
    حذف مورد تنظیم‌شده.
    با تغییر forceJoins، امضای عضویت
    نیز تغییر می‌کند.
    */
    bot.forceJoins.splice(
      index,
      1
    );

    saveDB();

    res.redirect(
      `/forcejoin?bot=${bot.id}`
    );
  }
);


