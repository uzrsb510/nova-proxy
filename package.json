              class="btn"
            >
              ورود
            </button>

          </form>

          <a
            class="btn green"
            href="/register"
          >
            ثبت‌نام
          </a>

        </div>
        `,

        req
      )
    );
  }
);

app.post(
  "/login",
  (req, res) => {

    const username =
      String(
        req.body.username ||
        ""
      ).trim();

    const password =
      String(
        req.body.password ||
        ""
      );

    const user =
      db.users.find(
        x =>
          x.username
            .toLowerCase() ===
          username.toLowerCase()
      );

    if (
      !user ||
      user.passwordHash !==
        hashPassword(
          password
        )
    ) {

      return res.send(
        messagePage(
          "خطا",
          "نام کاربری یا رمز عبور اشتباه است.",
          req,
          "error"
        )
      );
    }

    req.session.userId =
      user.id;

    res.redirect("/");
  }
);

app.get(
  "/logout",
  (req, res) => {

    req.session.destroy(
      () => {
        res.redirect(
          "/login"
        );
      }
    );
  }
);


