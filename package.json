==================================================
لینک تلگرام
==================================================
*/

function parsePublicTelegramLink(
  input
) {
  let value =
    String(
      input || ""
    ).trim();

  if (!value) {
    return null;
  }

  if (
    !/^https?:\/\/t\.me\//i.test(
      value
    )
  ) {

    if (
      /^t\.me\//i.test(
        value
      )
    ) {

      value =
        "https://" +
        value;

    } else {

      return null;
    }
  }

  try {

    const url =
      new URL(value);

    if (
      url.hostname
        .toLowerCase() !==
      "t.me"
    ) {
      return null;
    }

    const parts =
      url.pathname
        .split("/")
        .filter(Boolean);

    if (
      parts.length !== 1
    ) {
      return null;
    }

    const username =
      parts[0];

    if (
      username.startsWith(
        "+"
      ) ||
      username.toLowerCase() ===
        "joinchat"
    ) {
      return null;
    }

    if (
      !/^[A-Za-z0-9_]{5,32}$/.test(
        username
      )
    ) {
      return null;
    }

    return {
      username:
        "@" +
        username,

      link:
        "https://t.me/" +
        username
    };

  } catch {
    return null;
  }
}


/*
بررسی ادمین بودن ربات
*/
async function checkBotAdminInChat(
  bot,
  chatUsername
) {
  const me =
    await telegram(
      bot.token,
      "getMe"
    );

  const member =
    await telegram(
      bot.token,
      "getChatMember",
      {
        chat_id:
          chatUsername,

        user_id:
          me.id
      }
    );

  if (
    member.status !==
      "administrator" &&
    member.status !==
      "creator"
  ) {
    throw new Error(
      "ربات در این کانال یا گروه ادمین نیست."
    );
  }

  return {
    me,
    member
  };
}


/*
==================================================
دستورات ربات
==================================================
*/

async function executeCommand(
  bot,
  chatId,
  text
) {
  const commands =
    getCommands(
      bot.id
    );

  if (
    !Array.isArray(
      commands
    ) ||
    commands.length === 0
  ) {
    return false;
  }

  const first =
    String(
      text || ""
    )
      .trim()
      .split(/\s+/)[0]
      .toLowerCase();

  if (
    !first.startsWith("/")
  ) {
    return false;
  }

  const commandName =
    first
      .split("@")[0]
      .replace(
        /^\/+/,
        ""
      )
      .toLowerCase();

  const command =
    commands.find(
      x =>
        String(
          x.name
        ).toLowerCase() ===
        commandName
    );

  if (!command) {
    return false;
  }

  await sendTelegramMessage(
    bot.token,
    chatId,
    command.reply
  );

  return true;
}


/*
==================================================
ذخیره کاربران تلگرام
==================================================
*/

function saveTelegramUser(
  bot,
  message
) {
  if (!message.from) {
    return;
  }

  const botId =
    bot.id;

  if (
    !Array.isArray(
      db.botUsers[botId]
    )
  ) {
    db.botUsers[botId] = [];
  }

  const list =
    db.botUsers[botId];

  const exists =
    list.find(
      x =>
        x.id ===
        message.from.id
    );

  if (exists) {

    exists.username =
      message.from.username ||
      "";

    exists.firstName =
      message.from.first_name ||
      "";

    exists.lastName =
      message.from.last_name ||
      "";

    exists.chatId =
      message.chat.id;

    exists.updatedAt =
      new Date().toISOString();

  } else {

    list.push({
      id:
        message.from.id,

      chatId:
        message.chat.id,

      username:
        message.from.username ||
        "",

      firstName:
        message.from.first_name ||
        "",

      lastName:
        message.from.last_name ||
        "",

      createdAt:
        new Date().toISOString()
    });
  }

  saveDB();
}


/*
==================================================
دکمه بررسی عضویت
==================================================
*/

async function handleCallback(
  bot,
  callback
) {
  if (
    callback.data !==
    "check_join"
  ) {
    return;
  }

  const message =
    callback.message;

  if (!message) {
    return;
  }

  const chatId =
    message.chat.id;

  const userId =
    callback.from.id;

  /*
  بررسی واقعی عضویت
  */
  const result =
    await checkAllMemberships(
      bot,
      userId
    );

  /*
  اگر عضو همه موارد بود
  */
  if (result.ok) {

    /*
    ذخیره تأیید
    */
    markUserVerified(
      bot,
      userId
    );

    /*
    حذف پیام عضویت
    */
    try {

      await telegram(
        bot.token,
        "deleteMessage",
        {
          chat_id:
            chatId,

          message_id:
            message.message_id
        }
      );

    } catch (err) {
      console.error(
        "Delete join message error:",
        err.message
      );
    }

    /*
    تأیید دکمه
    */
    try {

      await telegram(
        bot.token,
        "answerCallbackQuery",
        {
          callback_query_id:
            callback.id,

          text:
            "✅ عضویت شما تأیید شد."
        }
      );

    } catch {}

    /*
    بعد از تأیید،
    دستور /start دوباره اجرا می‌شود.
    */
    try {

      await executeCommand(
        bot,
        chatId,
        "/start"
      );

    } catch (err) {

      console.error(
        "Start after join error:",
        err.message
      );
    }

    return;
  }

  /*
  اگر عضو نشده باشد
  */
  try {

    await telegram(
      bot.token,
      "answerCallbackQuery",
      {
        callback_query_id:
          callback.id,

        text:
          "❌ هنوز در همه موارد عضو نشده‌اید."
      }
    );

  } catch {}
}


/*
==================================================
دریافت Update
==================================================
*/

async function handleUpdate(
  bot,
  update
) {
  /*
  Callback
  */
  if (
    update.callback_query
  ) {

    await handleCallback(
      bot,
      update.callback_query
    );

    return;
  }

  /*
  پیام معمولی
  */
  if (!update.message) {
    return;
  }

  const message =
    update.message;

  const chatId =
    message.chat.id;

  /*
  ذخیره کاربر
  */
  saveTelegramUser(
    bot,
    message
  );

  /*
  بررسی عضویت اجباری
  */
  if (
    Array.isArray(
      bot.forceJoins
    ) &&
    bot.forceJoins.length > 0 &&
    message.from
  ) {

    const userId =
      message.from.id;

    /*
    اگر قبلاً تأیید نشده،
    عضویت بررسی می‌شود.
    */
    if (
      !isUserVerified(
        bot,
        userId
      )
    ) {

      const joined =
        await checkAllMemberships(
          bot,
          userId
        );

      /*
      اگر عضو نبود،
      پیام عضویت نشان داده می‌شود.
      */
      if (!joined.ok) {

        await sendJoinMessage(
          bot,
          chatId
        );

        return;
      }
    }
  }

  /*
  اگر پیام متن نیست
  */
  if (!message.text) {
    return;
  }

  /*
  اجرای دستور
  */
  const handled =
    await executeCommand(
      bot,
      chatId,
      message.text
    );

  if (handled) {
    return;
  }

  return;
}


/*
==================================================
Polling
==================================================
*/

const pollingTimers =
  new Map();

async function pollBot(
  bot
) {
  if (!bot.token) {
    return;
  }

  try {

    const updates =
      await telegram(
        bot.token,
        "getUpdates",
        {
          offset:
            Number(
              bot.offset || 0
            ),

          timeout: 25,

          allowed_updates: [
            "message",
            "callback_query"
          ]
        }
      );

    for (
      const update of updates
    ) {

      bot.offset =
        Number(
          update.update_id
        ) + 1;

      try {

        await handleUpdate(
          bot,
          update
        );

      } catch (err) {

        console.error(
          `Bot ${bot.username} update error:`,
          err.message
        );
      }
    }

    saveDB();

  } catch (err) {

    console.error(
      `Polling error for @${bot.username}:`,
      err.message
    );
  }

  if (
    db.bots.some(
      x =>
        x.id === bot.id
    )
  ) {

    pollingTimers.set(
      bot.id,
      setTimeout(
        () =>
          pollBot(bot),
        1000
      )
    );
  }
}

function startBotPolling(
  bot
) {
  if (
    pollingTimers.has(
      bot.id
    )
  ) {
    return;
  }

  pollBot(bot);
}

function stopBotPolling(
  botId
) {
  const timer =
    pollingTimers.get(
      botId
    );

  if (timer) {

    clearTimeout(
      timer
    );

    pollingTimers.delete(
      botId
    );
  }
}

async function startAllBots() {
  for (
    const bot of db.bots
  ) {
    startBotPolling(
      bot
    );
  }
}


